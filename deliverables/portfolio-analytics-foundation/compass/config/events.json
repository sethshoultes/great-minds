{
  "pinned": [
    {
      "event": "note_created",
      "description": "User created a new note",
      "outcome_focused": true,
      "properties_schema": {
        "note_id": "string",
        "word_count": "integer",
        "has_mention": "boolean"
      }
    },
    {
      "event": "note_acknowledged",
      "description": "User acknowledged a note they received",
      "outcome_focused": true,
      "properties_schema": {
        "note_id": "string",
        "time_to_ack_minutes": "integer"
      }
    },
    {
      "event": "mention_sent",
      "description": "User sent a mention to another user",
      "outcome_focused": true,
      "properties_schema": {
        "note_id": "string",
        "recipient_count": "integer"
      }
    },
    {
      "event": "daily_active_session",
      "description": "User had an active session (tracked once per day)",
      "outcome_focused": false,
      "properties_schema": {
        "session_duration_seconds": "integer",
        "notes_viewed": "integer"
      }
    }
  ],
  "dash": [
